DATABASE_URL="postgresql://...?sslmode=require"
DIRECT_URL="postgresql://..."              # migrations, bypasses pooler

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

CRON_SECRET="..."                          # guards the expiry sweep route

# Signs the staff admin session cookie (ll_admin) for /api/admin/*.
# A DIFFERENT secret from ORDER_SESSION_SECRET on purpose: one is a student
# reading one receipt, the other is staff reading every child's name and
# pressing refund. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# REQUIRED in production. Unset means nobody can sign in (fail closed).
# Rotating it invalidates every outstanding staff session immediately — that is
# the only way to revoke access, since there is no server-side session store.
ADMIN_SESSION_SECRET="..."

# The shared staff passcode. PLACEHOLDER PENDING A HUMAN DECISION — see
# docs/HANDOFF.md: there is no staff roster and no per-person account, so this
# one value is every staff member's credential and the audit log can never say
# who did what.
# Minimum 8 characters; anything shorter is treated as unset and refused.
# There is NO default and NO dev fallback, in any environment.
ADMIN_PASSCODE="..."

# ── P4b, the restricted inventory editor (/api/inventory/*) ──────────────────
# A THIRD, structurally independent auth system, not a role inside the staff one
# (lib/inventory-session.ts). It opens Product rows and nothing else: no order,
# no student, no payment, no setting is reachable with this session.
#
# Signs the ll_inventory cookie. A DIFFERENT secret from ADMIN_SESSION_SECRET and
# ORDER_SESSION_SECRET, on purpose — a token signed with any one of the three
# verifies under neither of the others. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# REQUIRED in production. Unset means nobody can sign in to /inventory (fail
# closed); rotating it revokes every inventory session and leaves staff sessions
# untouched.
INVENTORY_SESSION_SECRET="..."

# The inventory editors' shared passcode. **MUST NOT BE THE SAME VALUE AS
# ADMIN_PASSCODE.** These are family members doing catalog upkeep, not school
# staff, and the entire point of P4b is that they never hold the credential that
# opens student data and the refund button. Setting them equal does not merge the
# systems, but it does put the staff screen one remembered passcode away.
# Minimum 8 characters; anything shorter is treated as unset and refused.
# There is NO default and NO dev fallback, in any environment.
INVENTORY_PASSCODE="..."

# Signs the per-order confirmation cookie that authorises
# GET /api/orders/[orderNumber]. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# REQUIRED in production: with it unset, POST /api/checkout refuses rather than
# creating orders whose receipt nobody can open (lib/order-session.ts).
ORDER_SESSION_SECRET="..."

RESEND_API_KEY="..."
NEXT_PUBLIC_SITE_URL="https://lootlockers.ca"

# Rate limiting on POST /api/checkout (card-testing-bot defense). See
# lib/rate-limit.ts: with BOTH of these set, the limiter runs against real
# Upstash Redis. Without them, in production, with no explicit insecure
# opt-in, the limiter goes fail-closed — every checkout request throws
# RATE_LIMITED. Not provisioning Redis does not silently disable rate
# limiting, it takes checkout down entirely. REQUIRED in production.
UPSTASH_REDIS_REST_URL="..."
UPSTASH_REDIS_REST_TOKEN="..."

# Google OAuth for The Locker. The redirect URI must point to
# /api/account/google/callback on this site.
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
GOOGLE_REDIRECT_URI="http://localhost:3000/api/account/google/callback"

STITCH_API_KEY="..."                       # design extraction (frontend agent P0 task)

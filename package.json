{
  "name": "looplockers",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:constraints": "psql \"${DIRECT_URL:-$DATABASE_URL}\" -v ON_ERROR_STOP=1 -f prisma/migrations/manual_constraints.sql",
    "db:setup": "npm run db:migrate && npm run db:constraints && prisma db seed",
    "verify:inventory": "node scripts/verify-inventory-isolation.mjs",
    "test:unit": "QA_NO_SERVER=1 vitest run tests/unit",
    "test:concurrency": "vitest run tests/concurrency",
    "test:api": "vitest run tests/api",
    "test:ratelimit": "QA_RATE_LIMIT=on vitest run tests/ratelimit",
    "test:e2e": "playwright test",
    "test:leaks": "vitest run tests/leaks",
    "sweep:local": "curl -H \"Authorization: Bearer $CRON_SECRET\" localhost:3000/api/cron/sweep"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.15.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
